APP_NAME="Solo Inertia"
# production caches the routes in storage/cache/routes.php
APP_ENV=local
# Shows exception details instead of the error page: never in production
APP_DEBUG=true
APP_TIMEZONE=UTC
# Signs the cookie that carries errors and flash data to the next page.
# composer create-project fills it in; `composer key` makes a new one.
APP_KEY=

LOG_FILE=storage/logs/app.log
LOG_LEVEL=debug

# SQLite by default: the file is created on the first migration
DB_DRIVER=pdo_sqlite
DB_PATH=storage/database/app.sqlite

# MySQL / MariaDB
# DB_DRIVER=pdo_mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=app
# DB_USER=app
# DB_PASSWORD=secret

# PostgreSQL
# DB_DRIVER=pdo_pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=app
# DB_USER=app
# DB_PASSWORD=secret
